@model TaskCreateViewModel
@{
    ViewData["Title"] = "Yeni görev";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">YENİ GÖREV</p>
        <h1>Görev ekle</h1>
        <p class="muted">Başlık zorunludur. Diğer alanları ihtiyacına göre doldur.</p>
    </div>
</div>

<section class="card form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>

        <div class="field">
            <label asp-for="Title"></label>
            <input asp-for="Title" maxlength="120" autofocus />
            <span asp-validation-for="Title" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" rows="5" maxlength="1000"></textarea>
            <span asp-validation-for="Description" class="validation"></span>
        </div>

        <div class="field-grid">
            <div class="field">
                <label asp-for="Priority"></label>
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Priority>()"></select>
                <span asp-validation-for="Priority" class="validation"></span>
            </div>
            <div class="field">
                <label asp-for="Status"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<Status>()"></select>
                <span asp-validation-for="Status" class="validation"></span>
            </div>
        </div>

        <div class="form-actions">
            <a class="button subtle" asp-action="Index">Vazgeç</a>
            <button class="button primary" type="submit">Görev ekle</button>
        </div>
    </form>
</section>
