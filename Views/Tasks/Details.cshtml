@model TaskDetailsViewModel
@using WorkFlow.Mvc.Services
@{ ViewData["Title"] = "Görev detayı"; ViewData["PenPage"] = "details"; var task = Model.Task; }
<div class="pen-heading pen-detail-heading">
    <div>
        <a class="pen-back" asp-action="Index"><partial name="_PenIcon" model='"back"' />Görevlere dön</a>
        <p class="pen-detail-code">@task.Code</p>
        <h1 class="pen-detail-title">@task.Title</h1>
    </div>
    <a class="pen-button pen-primary" asp-action="Edit" asp-route-id="@task.Id"><partial name="_PenIcon" model='"edit"' />Görevi düzenle</a>
</div>
<partial name="_PenFeedback" />
<article class="pen-detail-card">
    <h2>Görev bilgileri</h2>
    <dl class="pen-detail-grid">
        <div><dt>Görev kodu</dt><dd>@task.Code</dd></div>
        <div><dt>Öncelik</dt><dd><span class="pen-priority priority-@task.Priority.ToString().ToLowerInvariant()">@(task.Priority == Priority.Normal ? "Medium" : task.Priority.ToString())</span></dd></div>
        <div><dt>Durum</dt><dd>@(task.Status == Status.Todo ? "Yapılacak" : task.Status == Status.InProgress ? "Devam ediyor" : "Tamamlandı")</dd></div>
        <div><dt>Oluşturulma (Türkiye saati)</dt><dd>@TimeZoneInfo.ConvertTimeFromUtc(task.CreatedDate, TaskDates.Istanbul).ToString("dd.MM.yyyy HH:mm")</dd></div>
        <div><dt>Son teslim tarihi</dt><dd>@(task.DueDate.HasValue ? TaskDates.LocalDate(task.DueDate.Value).ToString("dd.MM.yyyy") : "Belirlenmedi")</dd></div>
    </dl>
    @if (TaskDates.IsOverdue(task.DueDate, task.Status, Model.Today))
    { <p class="pen-overdue">Gecikmiş</p> }
    else if (TaskDates.IsUpcoming(task.DueDate, task.Status, Model.Today))
    { <p class="pen-upcoming">@(TaskDates.LocalDate(task.DueDate!.Value) == Model.Today ? "Son tarih bugün" : "Son tarih yaklaşıyor")</p> }
    <section class="pen-detail-description"><h2>Açıklama</h2><p>@(string.IsNullOrWhiteSpace(task.Description) ? "Bu görev için açıklama eklenmemiş." : task.Description)</p></section>
</article>
