@model TaskListViewModel
@using WorkFlow.Mvc.Services
@{
    ViewData["Title"] = "Görevler";
    ViewData["PenPage"] = "index";
    ViewData["TaskCount"] = Model.Summary.Total;
    string StatusText(Status status) => status switch { Status.Todo => "Yapılacak", Status.InProgress => "Devam ediyor", _ => "Tamamlandı" };
    string PriorityText(Priority priority) => priority == Priority.Normal ? "Medium" : priority.ToString();
    string? ListUrl(int page, Status? status) => Url.Action("Index", new Microsoft.AspNetCore.Routing.RouteValueDictionary
    {
        ["Filter.Search"] = Model.Filter.Search, ["Filter.Status"] = status,
        ["Filter.Priority"] = Model.Filter.Priority, ["Filter.Sort"] = Model.Filter.Sort,
        ["Filter.PageSize"] = Model.Filter.PageSize, ["Filter.Page"] = page
    });
}
<div class="pen-mobile-context">Görevler <span>@Model.Summary.Total</span></div>
<div class="pen-heading">
    <div><p class="pen-eyebrow">WORKFLOW PROJESİ</p><h1>Her görev, bir adım ileri.</h1><p>Tüm görevlerini tek bir yerden takip et ve güncel tut.</p></div>
    <a class="pen-button pen-primary" asp-action="Create"><partial name="_PenIcon" model='"plus"' />Yeni Görev</a>
</div>
<partial name="_PenFeedback" />
<section class="pen-summary" aria-label="Tüm görevlerin özeti">
    <div><span class="pen-metric-icon total"><partial name="_PenIcon" model='"layers"' /></span><div><strong>@Model.Summary.Total</strong><span>Toplam görev</span></div></div>
    <div><span class="pen-metric-icon todo"><partial name="_PenIcon" model='"circle"' /></span><div><strong>@Model.Summary.Todo</strong><span>Yapılacak</span></div></div>
    <div><span class="pen-metric-icon progress"><partial name="_PenIcon" model='"progress"' /></span><div><strong>@Model.Summary.InProgress</strong><span>Devam ediyor</span></div></div>
    <div><span class="pen-metric-icon completed"><partial name="_PenIcon" model='"check-circle"' /></span><div><strong>@Model.Summary.Completed</strong><span>Tamamlandı</span></div></div>
</section>
<section class="pen-task-panel" aria-label="Görev listesi">
    <div class="pen-table-toolbar">
        <nav class="pen-status-tabs" aria-label="Duruma göre filtrele">
            <a href="@ListUrl(1,null)" class="@(Model.Filter.Status is null ? "active" : null)" aria-current="@(Model.Filter.Status is null ? "true" : null)">Tüm görevler</a>
            @foreach (var status in Enum.GetValues<Status>())
            { <a href="@ListUrl(1,status)" class="@(Model.Filter.Status == status ? "active" : null)" aria-current="@(Model.Filter.Status == status ? "true" : null)">@StatusText(status)</a> }
        </nav>
        <form method="get" asp-action="Index" class="pen-search">
            <input type="hidden" name="Filter.Status" value="@Model.Filter.Status" />
            <input type="hidden" name="Filter.Priority" value="@Model.Filter.Priority" />
            <input type="hidden" name="Filter.Sort" value="@Model.Filter.Sort" />
            <input type="hidden" name="Filter.PageSize" value="@Model.Filter.PageSize" />
            <label class="pen-sr-only" for="task-search">Başlık veya açıklamada ara</label>
            <input id="task-search" name="Filter.Search" value="@Model.Filter.Search" type="search" maxlength="200" placeholder="Görevlerde ara..." />
            <button type="submit" class="pen-icon-button" aria-label="Görevlerde ara"><partial name="_PenIcon" model='"search"' /></button>
        </form>
    </div>
    <details class="pen-extra-filters" open="@(!ViewData.ModelState.IsValid || Model.Filter.Priority.HasValue || Model.Filter.Sort != TaskSort.Newest || Model.Filter.PageSize != 10)">
        <summary>Öncelik, sıralama ve sayfalama</summary>
        <form method="get" asp-action="Index">
            <input type="hidden" name="Filter.Search" value="@Model.Filter.Search" /><input type="hidden" name="Filter.Status" value="@Model.Filter.Status" />
            <div asp-validation-summary="All" class="pen-validation" role="alert"></div>
            <div><label asp-for="Filter.Priority">Öncelik</label><select asp-for="Filter.Priority"><option value="">Tüm öncelikler</option>@foreach(var priority in Enum.GetValues<Priority>()) { <option value="@((int)priority)">@PriorityText(priority)</option> }</select></div>
            <div><label asp-for="Filter.Sort">Sıralama</label><select asp-for="Filter.Sort" asp-items="Html.GetEnumSelectList<TaskSort>()"></select></div>
            <div><label asp-for="Filter.PageSize">Sayfa başına</label><select asp-for="Filter.PageSize"><option value="10">10 görev</option><option value="20">20 görev</option><option value="50">50 görev</option></select></div>
            <button class="pen-button pen-primary" type="submit">Uygula</button><a asp-action="Index" class="pen-button pen-secondary">Temizle</a>
        </form>
    </details>
    @if (Model.Tasks.Count == 0)
    {
        <div class="pen-empty">
            <span class="pen-empty-icon"><partial name="_PenIcon" model='"clipboard"' /></span>
            <h2>@(Model.Summary.Total == 0 ? "İlk görevine yer aç." : "Eşleşen görev bulunamadı.")</h2>
            <p>@(Model.Summary.Total == 0 ? "Henüz bir görev eklenmedi. Yeni bir görev oluşturarak işlerini düzenlemeye başla." : "Aramayı veya filtreleri değiştirerek tekrar dene.")</p>
            @if (Model.Summary.Total == 0) { <a class="pen-button pen-primary" asp-action="Create"><partial name="_PenIcon" model='"plus"' />İlk Görevini Oluştur</a> }
            else { <a class="pen-button pen-secondary" asp-action="Index">Filtreleri temizle</a> }
        </div>
    }
    else
    {
        <table class="pen-task-table">
            <caption class="pen-sr-only">Görevler; öncelik, durum ve işlemler</caption>
            <thead><tr><th scope="col">GÖREV</th><th scope="col">ÖNCELİK</th><th scope="col">DURUM</th><th scope="col">İŞLEM</th></tr></thead>
            <tbody>
            @foreach (var task in Model.Tasks)
            {
                <tr class="pen-task-row">
                    <td class="pen-task-info">
                        <div class="pen-task-title"><span class="pen-task-code">@task.Code</span><a asp-action="Details" asp-route-id="@task.Id">@task.Title</a></div>
                        @if (!string.IsNullOrWhiteSpace(task.Description)) { <p>@task.Description</p> }
                        @if (task.DueDate.HasValue)
                        {
                            <div class="pen-due">Son tarih: @TaskDates.LocalDate(task.DueDate.Value).ToString("dd.MM.yyyy")
                                @if (TaskDates.IsOverdue(task.DueDate,task.Status,Model.Today)) { <span class="pen-overdue">Gecikmiş</span> }
                                else if(TaskDates.IsUpcoming(task.DueDate,task.Status,Model.Today)) { <span class="pen-upcoming">@(TaskDates.LocalDate(task.DueDate.Value) == Model.Today ? "Bugün" : "Yaklaşıyor")</span> }
                            </div>
                        }
                    </td>
                    <td class="pen-priority-cell"><span class="pen-priority priority-@task.Priority.ToString().ToLowerInvariant()">@PriorityText(task.Priority)</span></td>
                    <td class="pen-status-cell">
                        <form asp-action="UpdateStatus" method="post" class="pen-status-form">
                            <partial name="_ListContext" model="Model.Filter" /><input type="hidden" name="gorevId" value="@task.Id" />
                            <label class="pen-sr-only" for="status-@task.Id">@task.Code görev durumu</label>
                            <select id="status-@task.Id" name="yeniDurum" class="status-@task.Status.ToString().ToLowerInvariant()">
                                @foreach(var status in Enum.GetValues<Status>()) { <option value="@status" selected="@(task.Status == status)">@StatusText(status)</option> }
                            </select>
                            <button class="pen-status-save pen-icon-button" type="submit" aria-label="@task.Code durumunu kaydet" title="Durumu kaydet"><partial name="_PenIcon" model='"check"' /></button>
                        </form>
                    </td>
                    <td class="pen-row-actions">
                        <a class="pen-icon-button" asp-action="Edit" asp-route-id="@task.Id" aria-label="@task.Code görevini düzenle" title="Düzenle"><partial name="_PenIcon" model='"edit"' /></a>
                        <form asp-action="Delete" method="post" class="pen-delete-form" data-task-code="@task.Code" data-task-title="@task.Title">
                            <partial name="_ListContext" model="Model.Filter" /><input type="hidden" name="gorevId" value="@task.Id" />
                            <button class="pen-icon-button" type="button" data-open-delete aria-label="@task.Code görevini sil" title="Sil" disabled><partial name="_PenIcon" model='"trash"' /></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    <footer class="pen-table-footer"><span>@Model.Pagination.TotalCount sonuç · @Model.Tasks.Count görev gösteriliyor</span><span>@Html.DisplayFor(m => m.Filter.Sort)</span></footer>
    @if (Model.Pagination.TotalPages > 1)
    {
        <nav class="pen-pagination" aria-label="Görev sayfaları">
            @if (Model.Pagination.Page > 1) { <a href="@ListUrl(Model.Pagination.Page - 1,Model.Filter.Status)" rel="prev">Önceki</a> }
            @for(var page = Math.Max(1,Model.Pagination.Page - 2); page <= Math.Min(Model.Pagination.TotalPages,Model.Pagination.Page + 2); page++)
            { if(page == Model.Pagination.Page) { <span aria-current="page">@(page)</span> } else { <a href="@ListUrl(page,Model.Filter.Status)" aria-label="Sayfa @(page)">@(page)</a> } }
            @if(Model.Pagination.Page < Model.Pagination.TotalPages) { <a href="@ListUrl(Model.Pagination.Page + 1,Model.Filter.Status)" rel="next">Sonraki</a> }
        </nav>
    }
</section>
<noscript><p class="pen-no-script">Silme onay penceresi ve mobil menü için JavaScript gereklidir. <a asp-action="Create">Yeni görev oluştur</a>.</p></noscript>
<dialog id="delete-confirmation" class="pen-delete-dialog" aria-labelledby="delete-heading" aria-describedby="delete-description">
    <div class="pen-dialog-icons"><span><partial name="_PenIcon" model='"trash"' /></span><button class="pen-icon-button" type="button" data-close-delete aria-label="Pencereyi kapat"><partial name="_PenIcon" model='"x"' /></button></div>
    <div><h2 id="delete-heading">Görevi silmek istiyor musun?</h2><p id="delete-description">Bu görev listeden kaldırılacak. Bu işlem geri alınamaz.</p></div>
    <div class="pen-delete-task"><span data-delete-code></span><strong data-delete-title></strong></div>
    <div class="pen-dialog-actions"><button class="pen-button pen-secondary" type="button" data-close-delete autofocus>Vazgeç</button><button class="pen-button pen-danger" type="button" data-confirm-delete><partial name="_PenIcon" model='"trash"' />Görevi Sil</button></div>
</dialog>