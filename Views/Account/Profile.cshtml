@using WorkFlow.Mvc.Services
@model ProfileViewModel
@{
    ViewData["Title"] = "Profilim";
    ViewData["PenPage"] = "account";
    var savedName = ViewData["SavedDisplayName"] as string;
    var profileName = string.IsNullOrWhiteSpace(savedName) ? "Kullanıcı" : savedName.Trim();
}
<div class="pen-heading pen-account-heading"><div><h1>Profilim</h1></div></div>
<partial name="_PenFeedback" />
<div class="pen-account-page">
    <section class="pen-profile-summary" aria-label="Profil özeti">
        <span class="pen-profile-avatar" aria-hidden="true">@if (Model.PhotoKey.HasValue) { <img src="@Url.Action("Photo", "Account", new { id = Model.PhotoKey })" alt="" /> } else { @Model.Initials }</span>
        <div class="pen-profile-identity">
            <h2 data-profile-saved-name>@profileName</h2>
            <p>@Model.Email</p>
            @if (Model.JoinedAtUtc is DateTimeOffset joined)
            {
                var localDate = TaskDates.LocalDate(joined.UtcDateTime);
                <p>Üyelik tarihi: <time datetime="@localDate.ToString("yyyy-MM-dd")">@localDate.ToString("dd.MM.yyyy")</time></p>
            }
            else
            {
                <p>Üyelik tarihi kayıtlı değil.</p>
            }
        </div>
    </section>
    <section class="pen-form-card pen-account-card" aria-labelledby="profile-heading">
        <header><span class="pen-form-icon"><partial name="_PenIcon" model='"edit"' /></span><div><h2 id="profile-heading">Kişisel bilgiler</h2></div></header>
        <form asp-action="Profile" method="post" novalidate>
            <div class="pen-form-fields">
                @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0) { <div asp-validation-summary="ModelOnly" class="pen-notice pen-notice-error" role="alert"></div> }
                <div class="pen-field"><label asp-for="DisplayName">Görünen ad</label><input asp-for="DisplayName" autocomplete="nickname" maxlength="80" aria-describedby="display-name-error" aria-invalid="@(ViewData.ModelState[nameof(Model.DisplayName)]?.Errors.Count > 0 ? "true" : "false")" /><span id="display-name-error" asp-validation-for="DisplayName" class="pen-field-error"></span></div>
                <div class="pen-field"><label asp-for="AboutMe">Hakkımda</label><textarea asp-for="AboutMe" maxlength="240" rows="3" aria-describedby="about-me-error" aria-invalid="@(ViewData.ModelState[nameof(Model.AboutMe)]?.Errors.Count > 0 ? "true" : "false")"></textarea><span id="about-me-error" asp-validation-for="AboutMe" class="pen-field-error"></span></div>
                <div class="pen-field"><label for="profile-email">E-posta</label><input id="profile-email" value="@Model.Email" type="email" readonly aria-describedby="profile-email-help" /><span id="profile-email-help" class="pen-field-hint">E-posta adresi bu sayfadan değiştirilemez.</span></div>
            </div>
            <div class="pen-form-actions"><a class="pen-button pen-secondary" asp-action="Profile" data-profile-cancel>İptal</a><button class="pen-button pen-primary" type="submit">Değişiklikleri kaydet</button></div>
        </form>
    </section>
    <section class="pen-form-card pen-account-card" aria-labelledby="profile-photo-heading">
        <header><span class="pen-form-icon"><partial name="_PenIcon" model='"edit"' /></span><div><h2 id="profile-photo-heading">Profil fotoğrafı</h2><p>JPEG veya PNG, en fazla 2 MB.</p></div></header>
        <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data">
            <div class="pen-form-fields"><div class="pen-field"><label for="profile-photo">Fotoğraf seç</label><input id="profile-photo" name="photo" type="file" accept="image/jpeg,image/png" required /></div></div>
            <div class="pen-form-actions"><button class="pen-button pen-primary" type="submit">@(Model.PhotoKey.HasValue ? "Fotoğrafı değiştir" : "Fotoğrafı yükle")</button></div>
        </form>
        @if (Model.PhotoKey.HasValue) { <form asp-action="RemovePhoto" method="post" class="pen-photo-remove"><button class="pen-button pen-secondary" type="submit">Fotoğrafı kaldır</button></form> }
    </section>
</div>
