@model WorkFlow.Mvc.Models.TaskItem
@{
    var status = Model.Status == Status.Todo ? "Yapılacak" : Model.Status == Status.InProgress ? "Devam ediyor" : "Tamamlandı";
    var priority = Model.Priority switch { Priority.Critical => "Kritik", Priority.High => "Yüksek", Priority.Normal => "Normal", _ => "Düşük" };
    var accessibleName = $"{Model.Code} {Model.Title}, {status}, {priority} öncelik";
}
<a class="pen-calendar-token priority-@Model.Priority.ToString().ToLowerInvariant()" asp-controller="Tasks" asp-action="Details" asp-route-id="@Model.Id" aria-label="@accessibleName" title="@accessibleName">
    <span class="pen-calendar-token-dot" aria-hidden="true"></span><span class="pen-calendar-token-text">@Model.Code @Model.Title</span><span class="pen-calendar-token-full" aria-hidden="true">@accessibleName</span>
</a>
