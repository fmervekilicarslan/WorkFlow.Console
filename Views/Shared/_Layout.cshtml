<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - WorkFlow</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" asp-controller="Tasks" asp-action="Index">WorkFlow</a>
            <span class="header-caption">Staj görev yönetimi</span>
        </div>
    </header>
    <main class="shell">
        @RenderBody()
    </main>
</body>
</html>
